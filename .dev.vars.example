# Copy to .dev.vars for local development. Never commit real keys.
# On a deployed Worker use `npx wrangler secret put <NAME>` instead.

# Staff fallback PIN and session signing key. ADMIN_SECRET is required: without it staff and
# operator sign-in return 503 rather than signing sessions with a known default.
ADMIN_PIN=
ADMIN_SECRET=

# Unlocks /operator, the console that creates cafés. No default: unset closes the console.
OPERATOR_PASSWORD=

# Encrypts each café's TOTP secret at rest. Required for two-factor sign-in: there is no fallback to
# ADMIN_SECRET, and enrollment answers 503 while this is missing or malformed. Must be exactly 32
# random bytes as unpadded base64url (43 characters) and independent of every other secret.
# Generate (once, locally) — never commit the output:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# After rotating this value, put the retired value in MFA_ENC_KEY_PREVIOUS so existing enrollments
# keep working (decrypt-only); new enrollments always use MFA_ENC_KEY.
# MFA_ENC_KEY=
# MFA_ENC_KEY_PREVIOUS=

# The values below are only the STARTING point for the FIRST café on a deployment. Once the owner
# saves "Café setup" in the staff panel, D1 holds the real name, service mode and clock, and these
# are ignored. Every later café is created from /operator with its own hashed password.

# Name shown in the app
CAFE_NAME=Your Café

# "tables" = guests scan a table code. "counter" = pickup ordering with no tables.
SERVICE_MODE=tables
# Minutes the café clock runs ahead of UTC, so takings and pickup numbers roll over at local midnight.
CAFE_TZ_OFFSET_MIN=330

# Fallback owner password for the first café's board (/c/<slug>/owner). No default — login is
# refused while this is unset and the café has no password of its own.
OWNER_PASSWORD=

# Razorpay — this build takes online payments through Razorpay only.
# Without the key secret the guest is offered counter payment instead; there is no direct-UPI fallback.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: Telegram alert for every newly paid order.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
