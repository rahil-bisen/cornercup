{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corner-cup",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Argon2id ships two small pre-compiled modules. workerd never compiles wasm from bytes, so the
  // binaries are imported statically and instantiated with the application's own memory.
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corner-cup",
      "database_id": "eefda06c-f8d6-483d-85f2-a6a21b1827d8"
    }
  ],
  // Menu photographs. `wrangler dev` simulates this bucket locally, so the upload path can be
  // exercised without an account. A deploy requires the bucket to exist:
  //   wrangler r2 bucket create corner-cup-images
  // Until it does, `wrangler deploy` fails on the missing bucket rather than shipping a Worker whose
  // photo uploads answer 503, and the menu keeps its category defaults either way.
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "corner-cup-images"
    }
  ],
  "observability": {
    "enabled": true
  },
  // `wrangler deploy` turns every name listed here into an "inherit" binding, and Cloudflare rejects
  // the whole upload if any of them is not set on the deployed Worker. So this list holds only the
  // secrets a Cloudflare deployment cannot run without. Optional secrets (two-factor, WorkOS,
  // Razorpay, Telegram, ...) still reach the deployed Worker whenever they are set with
  // `wrangler secret put`; they are just not demanded.
  "secrets": {
    "required": ["ADMIN_SECRET", "OPERATOR_PASSWORD"]
  },
  "env": {
    // `npm run dev` and `npm start` run `wrangler dev --env selfhost`. Declaring secrets makes
    // `wrangler dev` load ONLY the listed keys from .dev.vars / process.env, so this list names every
    // key the Worker reads from `env`, optional ones included. In `wrangler dev` a missing key is only
    // a warning. Bindings are not inherited by a named environment, so they are repeated here.
    "selfhost": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "corner-cup",
          "database_id": "eefda06c-f8d6-483d-85f2-a6a21b1827d8"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "corner-cup-images"
        }
      ],
      "secrets": {
        "required": [
          "ADMIN_SECRET",
          "OPERATOR_PASSWORD",
          "OWNER_PASSWORD",
          "MFA_ENC_KEY",
          "MFA_ENC_KEY_PREVIOUS",
          "ORDER_TRACK_SECRET",
          "RAZORPAY_KEY_ID",
          "RAZORPAY_KEY_SECRET",
          "RAZORPAY_WEBHOOK_SECRET",
          "WORKOS_API_BASE",
          "WORKOS_API_KEY",
          "WORKOS_AUDIENCE",
          "WORKOS_CLIENT_ID",
          "WORKOS_ISSUER",
          "WORKOS_REDIRECT_URI",
          "WORKOS_STATE_ENCRYPTION_KEY",
          "TELEGRAM_BOT_TOKEN",
          "TELEGRAM_OWNER_CHAT_ID",
          "CAFE_NAME",
          "CAFE_SLUG",
          "CAFE_TZ_OFFSET_MIN",
          "SERVICE_MODE",
          "SEED_DEMO_DATA",
          "API_READ_MAX",
          "RATE_LIMIT_CLEANUP_PROBABILITY"
        ]
      }
    }
  }
}
