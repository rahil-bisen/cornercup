{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corner-cup",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Argon2id ships two small pre-compiled modules. workerd never compiles wasm from bytes, so the
  // binaries are imported statically and instantiated with the application's own memory.
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corner-cup",
      "database_id": "eefda06c-f8d6-483d-85f2-a6a21b1827d8"
    }
  ],
  // Menu photographs. `wrangler dev` simulates this bucket locally, so the upload path can be
  // exercised without an account. A deploy requires the bucket to exist:
  //   wrangler r2 bucket create corner-cup-images
  // Until it does, `wrangler deploy` fails on the missing bucket rather than shipping a Worker whose
  // photo uploads answer 503, and the menu keeps its category defaults either way.
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "corner-cup-images"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Declaring secrets makes Wrangler load ONLY these keys from .dev.vars / process.env, so every
  // secret the Worker reads has to be listed here or it silently disappears from `env`.
  "secrets": {
    "required": [
      "ADMIN_SECRET",
      "OPERATOR_PASSWORD",
      "OWNER_PASSWORD",
      "MFA_ENC_KEY",
      "RAZORPAY_KEY_ID",
      "RAZORPAY_KEY_SECRET"
    ]
  }
}
